{
  "name": "abyssal-garden",
  "private": true,
  "description": "The island of Thera and its town at Akrotiri in 1615 BCE, rendered with WebGPU and bundled into one HTML file (a fork of Abyssal Garden)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:readable": "node build.mjs --readable",
    "build:dev": "node build.mjs --dev",
    "check": "bash ../checks/build.sh",
    "views": "node ../checks/views.mjs --views 9",
    "terrain": "node ../tools/terrain/build.mjs",
    "town": "node ../tools/town/build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
