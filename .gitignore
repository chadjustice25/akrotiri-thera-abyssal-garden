node_modules/
dev.html
.DS_Store

# Reference images (photographs of the Akrotiri wall paintings) stay local: this fork is
# public, and the reproduction rights are not settled (docs/DECISIONS.md D6; research lane T6).
akrotiri-frescoes-sources/

# Harness: gate exports and personal notes stay local (unghost CONTRACTS.md section 2)
.harness/exports/
.harness/notes/

# Third-party project skills and personal Claude settings stay out of git
.claude/skills/
.claude/settings.local.json
.harness/views/
# downloaded source copies never belong in the repo (D6, licences)
docs/research/**/*.pdf
docs/research/claude/*.txt

# Terrain tools: the downloaded elevation data is fetched again by tools/terrain/fetch.mjs, never committed
tools/terrain/cache/

# Town tools: the plan is fetched again by tools/town/fetch.mjs, never committed (its outlines are, under CC BY-SA 4.0)
tools/town/cache/
